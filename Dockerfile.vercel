# Vercel container build (auto-detected). Same image as Dockerfile, listening on :80.

FROM oven/bun:1 AS web
WORKDIR /web
COPY frontend/package.json frontend/bun.lock ./
RUN bun install --frozen-lockfile
COPY frontend/ ./
RUN bun run build

FROM golang:1.25-alpine AS api
WORKDIR /src
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /server .

FROM bluenviron/mediamtx:1 AS mediamtx

FROM alpine:3.22
RUN apk add --no-cache ffmpeg tini
COPY --from=mediamtx /mediamtx /usr/local/bin/mediamtx
COPY --from=api /server /usr/local/bin/server
COPY --from=web /web/dist /app/public
COPY scripts/mediamtx.yml /app/mediamtx.yml
COPY scripts/start.sh /app/start.sh
# Vercel routes container traffic to port 80 unless the PORT project env var overrides it.
ENV STATIC_DIR=/app/public PORT=80
EXPOSE 80
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["/app/start.sh"]
